{
  "name": "nivora",
  "version": "0.1.0",
  "description": "Nivora — Aprenda. Supere. Evolua. Plataforma de simulados com IA (Cloudflare Workers + D1)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nivora-db --local",
    "db:migrate": "wrangler d1 migrations apply nivora-db --remote",
    "db:create": "wrangler d1 create nivora-db",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check:frontend": "node --check public/js/app.js && node --check public/js/faq.js && node --check public/js/icones.js"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "hono": "^4.7.0"
  }
}
