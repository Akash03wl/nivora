{
  "name": "nivora",
  "version": "0.1.0",
  "description": "Nivora — Aprenda. Supere. Evolua. Plataforma de simulados com IA (Cloudflare Workers + D1)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply nivora-db --local",
    "db:migrate": "wrangler d1 migrations apply nivora-db --remote",
    "db:create": "wrangler d1 create nivora-db",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "^4.120.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "hono": "^4.7.0"
  }
}
