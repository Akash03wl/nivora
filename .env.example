# NIVORA — variáveis de ambiente
# Copie para .dev.vars (local) ou configure via wrangler secret put

ENVIRONMENT=development
SITE_URL=https://nivora.app

# D1 já vinculado via wrangler.jsonc (binding DB)
# Após criar: wrangler d1 create nivora-db → colar database_id em wrangler.jsonc

# IA (Workers AI binding AI opcional) + fallback OpenRouter/Gemini
AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# AI_API_KEY=
# AI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Auth: o cadastro público em produção sempre cria USER.
# A promoção inicial de ADMIN é uma operação manual e auditável no D1.

# E-mail transacional (recuperação de senha) — Resend, plano gratuito: 3.000 e-mails/mês, 100/dia
# Em produção use: npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY=
# Remetente verificado no Resend, ex.: Nivora <nao-responder@nivora.app>
RESEND_FROM=Nivora <onboarding@resend.dev>

# Scoring (usa defaults de src/lib/config.ts se ausente)
# SCORING_CORRECT=100
# SCORING_SPEED_MAX=20
